  "cards": [
    {
      "dot": "emerald",
      "title": "产卡为什么要绕一圈",
      "items": [
        "先确定性抽事实，再受约束写作，正文逐段标引用编号",
        "抽不出 2 条以上事实的材料，直接不产卡",
        "两级筛选：能算的交给程序，值不值得读交给模型"
      ]
    },
    {
      "dot": "cyan",
      "title": "读写分权",
      "items": [
        "主人口令可写；只读演示口令在服务端被拒一切写操作",
        "写锁放在统一入口，新增接口不会漏判",
        "演示角色看得到数据，改不动数据"
      ]
    },
    {
      "dot": "rose",
      "title": "已知不足",
      "items": [
        "调用审计只覆盖走统一出口的调用，巡检与管家是直连",
        "成功标准还没埋点：能证明卡被读了，证明不了判断变了",
        "候选池小时排序会系统性挤掉深度源"
      ]
    }
  ]
